    <script id="threeui-checkout-return">
      // Run before the Google tag can read a Stripe return URL. Keep this
      // explicit-ID capture in sync with src/checkoutReturn.ts.
      (() => {
        const url = new URL(window.location.href);
        const legacyReturn = url.pathname === "/pricing"
          && ["success", "processing"].includes(url.searchParams.get("checkout") || "");
        if ((url.pathname !== "/purchase/success" && !legacyReturn) || !url.searchParams.has("session_id")) return;
        const id = url.searchParams.get("session_id") || "";
        const valid = url.searchParams.getAll("session_id").length === 1 && /^cs_(?:test|live)_[A-Za-z0-9]+$/.test(id);
        const capturedAt = Date.now();
        try {
          if (valid) {
            window.sessionStorage.setItem("threeui.checkout-session.v1", id);
            window.sessionStorage.setItem("threeui.checkout-captured-at.v1", String(capturedAt));
          } else {
            window.sessionStorage.removeItem("threeui.checkout-session.v1");
            window.sessionStorage.removeItem("threeui.checkout-captured-at.v1");
          }
        } catch { /* History still supports verification when storage is blocked. */ }
        url.searchParams.delete("session_id");
        if (legacyReturn) {
          url.pathname = "/purchase/success";
          url.searchParams.delete("checkout");
        }
        const state = { ...window.history.state };
        if (valid) {
          state.threeuiCheckoutSessionId = id;
          state.threeuiCheckoutCapturedAt = capturedAt;
        } else {
          delete state.threeuiCheckoutSessionId;
          delete state.threeuiCheckoutCapturedAt;
        }
        window.history.replaceState(state, "", url);
      })();
    </script>
