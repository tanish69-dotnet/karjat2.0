    <script>
      (() => {
        const root = document.documentElement;
        const palettes = new Set(["mono", "sepia", "azure", "moss", "mauve"]);
        try {
          const savedTheme = localStorage.getItem("threeui-theme");
          const lightPalette = localStorage.getItem("threeui-palette-light");
          const darkPalette = localStorage.getItem("threeui-palette-dark");
          const mode = savedTheme === "light" || savedTheme === "system" ? savedTheme : "dark";
          if (mode === "system") root.removeAttribute("data-theme");
          else root.dataset.theme = mode;
          const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          const scheme = mode === "system" ? (prefersDark ? "dark" : "light") : mode;
          root.dataset.scheme = scheme;
          const palette = scheme === "dark" ? darkPalette : lightPalette;
          root.dataset.palette = palettes.has(palette) ? palette : "mono";
        } catch {
          root.dataset.theme = "dark";
          root.dataset.scheme = "dark";
          root.dataset.palette = "mono";
        }
      })();
    </script>
    <style id="threeui-initial-load-styles">
      /* Inline so the SEO fallback cannot flash before the app CSS arrives. */
      [data-threeui-loader] { display: none; }
      html[data-threeui-booting] [data-threeui-static] { display: none; }
      html[data-threeui-booting] [data-threeui-loader] {
        --initial-ink: var(--foreground, #edeef0);
        position: fixed;
        inset: 0;
        display: grid;
        place-items: center;
        box-sizing: border-box;
        padding: 24px;
        background: var(--content-bg, #131416);
        color: var(--foreground-muted, #8a8f98);
        font: 12px/1.6 -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
        text-align: center;
      }
      html[data-scheme="light"][data-threeui-booting] [data-threeui-loader] {
        --initial-ink: var(--foreground, #242424);
        background: var(--content-bg, #fbfbfa);
        color: var(--foreground-muted, #5c5c5a);
      }
      .initial-load-center {
        position: relative;
        display: grid;
        justify-items: center;
        gap: 28px;
      }
      .initial-load-brand {
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--initial-ink);
        opacity: .88;
      }
      .initial-load-brand svg { display: block; width: 36px; height: 36px; }
      .initial-load-brand span {
        font-size: 24px;
        font-weight: 600;
        line-height: 1;
        letter-spacing: -.9px;
      }
      .initial-load-track {
        width: 72px;
        height: 2px;
        overflow: hidden;
        border-radius: 2px;
        background: color-mix(in srgb, var(--initial-ink) 9%, transparent);
      }
      .initial-load-track span {
        display: block;
        width: 28px;
        height: 100%;
        border-radius: inherit;
        background: var(--initial-ink);
        animation: threeui-initial-drift 1.8s cubic-bezier(.45, 0, .25, 1) infinite;
      }
      @keyframes threeui-initial-drift {
        0% { transform: translateX(-28px); opacity: 0; }
        25%, 65% { opacity: .45; }
        100% { transform: translateX(72px); opacity: 0; }
      }
      @media (prefers-reduced-motion: reduce) {
        .initial-load-track span { animation: none; transform: translateX(22px); opacity: .45; }
      }
      [data-threeui-loader] [role="status"] {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }
      [data-threeui-loader] p { margin: 0; }
      [data-threeui-recovery] {
        position: absolute;
        top: calc(100% + 28px);
        left: 50%;
        width: min(320px, calc(100vw - 48px));
        transform: translateX(-50%);
      }
      [data-threeui-recovery] button,
      [data-threeui-recovery] a {
        display: inline-block;
        margin: 12px 4px 0;
        padding: 7px 11px;
        border: 1px solid color-mix(in srgb, var(--initial-ink) 14%, transparent);
        border-radius: 5px;
        background: transparent;
        color: inherit;
        font: inherit;
        text-decoration: none;
        cursor: pointer;
        transition: color .2s, border-color .2s;
      }
      [data-threeui-recovery] button:hover,
      [data-threeui-recovery] a:hover {
        color: var(--initial-ink);
        border-color: color-mix(in srgb, var(--initial-ink) 30%, transparent);
      }
      [data-threeui-recovery] button:focus-visible,
      [data-threeui-recovery] a:focus-visible {
        outline: 2px solid var(--initial-ink);
        outline-offset: 3px;
      }
    </style>
    <script id="threeui-initial-load">
      (() => {
        const root = document.documentElement;
        root.setAttribute("data-threeui-booting", "");
        // React replaces the entire initial root, including this loader. If
        // its bundle fails, offer recovery without automatically flashing text.
        window.setTimeout(() => {
          const recovery = document.querySelector("[data-threeui-recovery]");
          if (!recovery) return;
          const basicView = recovery.querySelector("button");
          basicView.addEventListener("click", () => {
            root.removeAttribute("data-threeui-booting");
            document.querySelector("[data-threeui-static]")?.focus();
          }, { once: true });
          recovery.hidden = false;
        }, 10000);
      })();
    </script>
