{
  "manifest_version": 3,
  "name": "Thaw — Adaptive Focus & Cognitive Guardian",
  "version": "1.0.0",
  "description": "Monitors tab switching, gently detects procrastination signals, and nudges neurodivergent minds back to calm focus without shaming.",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Thaw Focus Guardian"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
